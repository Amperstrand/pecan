# Custom Unit Mint — deployment configuration.
#
# The installer (install.sh / mintctl) generates a real .env from this
# template; from a source checkout everything has a working default and no
# .env is needed. Compose reads this file automatically from the project
# directory.

# Image tag to run, e.g. v0.1.0. Immutable release tags are what installs
# pin; "latest" tracks the newest release, "edge" the newest main commit.
VERSION=latest

# Compose project name; also prefixes the named volumes. The installer sets
# it once so moving the install directory never orphans the volumes.
#COMPOSE_PROJECT_NAME=custom-unit-mint

# Host ports for the operator UI and the wallet-facing mint API.
UI_PORT=9090
MINT_PORT=8089

# Host interface for the two ports above. The installer sets 127.0.0.1 in
# TLS mode so Caddy on :80/:443 is the only public surface (the direct ports
# stay reachable over SSH for debugging); 0.0.0.0 in plain-HTTP mode.
BIND_ADDR=0.0.0.0

# TLS mode. Set all three (and BIND_ADDR=127.0.0.1) to serve the mint at
# https://$DOMAIN and the console at https://$CONSOLE_DOMAIN via the bundled
# Caddy with automatic Let's Encrypt certificates. Both names need DNS A/AAAA
# records pointing at this server, and ports 80+443 must be reachable.
#COMPOSE_PROFILES=tls
#DOMAIN=mint.example.org
#CONSOLE_DOMAIN=console.mint.example.org

# The URL wallets use, advertised in the mint's NUT-06 info. First-boot
# default only — after that it is edited from the console's Mint tab.
#MINT_PUBLIC_URL=https://mint.example.org

# First boot only (before users.json exists): seeds the "admin" account with
# this password instead of the demo admin/admin credentials. Minimum 8
# characters. Inert once the user store exists; kept here as a recovery path
# in case the printed password is lost before the operator changes it.
#INITIAL_ADMIN_PASSWORD=

# Optional ACME account email; mintctl re-applies it to the Caddyfile after
# updates.
#ACME_EMAIL=
